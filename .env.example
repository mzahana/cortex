# ------------------------------------------------------------------------------
# Cortex environment configuration — EXAMPLE FILE.
# Copy to `.env` (never commit `.env`), fill in real values. This file must only
# ever contain placeholders. `.env` is mounted read-only into containers per
# docs/deployment.md and is the ONLY source of secrets (never baked into images).
# ------------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-generate-a-long-random-value-and-never-commit-it
DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.prod

# ASSUMPTION (open question, docs/risks.md §3 Q3 — hostname not yet confirmed):
# using a placeholder domain. Replace with the real Cloudflare Tunnel hostname
# before deploy, and keep this in sync with the Tunnel public hostname config.
ALLOWED_HOSTS=cortex.example.com
CSRF_TRUSTED_ORIGINS=https://cortex.example.com

# Absolute base URL of the PWA, used only to build the emailed password-reset
# link (`{FRONTEND_BASE_URL}/reset-password?token=...&tenant=...`). Set to the
# real Cloudflare Tunnel hostname before deploy (same host as ALLOWED_HOSTS
# above). Defaults to http://localhost if unset.
FRONTEND_BASE_URL=https://cortex.example.com
# How long a forgot-password reset link stays valid, in seconds (default 3600 = 1h).
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# --- Database ----------------------------------------------------------------
# Consumed directly by Django (django-environ db() parsing) AND used to derive
# the postgres container's own POSTGRES_* vars below — keep them consistent.
# NOTE: `cortex` (POSTGRES_USER) is the migration/owner role. Migrations run as it.
DATABASE_URL=postgres://cortex:changeme-db-password@postgres:5432/cortex
POSTGRES_DB=cortex
POSTGRES_USER=cortex
POSTGRES_PASSWORD=changeme-db-password

# --- Application DB role (T0.5 — Postgres RLS backstop) -----------------------
# Non-superuser, NOBYPASSRLS role the migration `tenancy.0003_app_db_role`
# provisions. RLS only fires for a role subject to it, so the *runtime*
# (web/worker/beat) DB connection uses this role while migrations keep using the
# owner `cortex` above. This is WIRED in docker-compose.yml: the one-off `migrate`
# service runs as owner (DATABASE_URL), and web/worker/beat override
# DATABASE_URL to APP_DATABASE_URL (cortex_app). Do NOT revert the runtime services
# to the owner role — a superuser bypasses RLS and silently disables the R4
# backstop.
APP_DB_USER=cortex_app
APP_DB_PASSWORD=changeme-app-db-password
APP_DATABASE_URL=postgres://cortex_app:changeme-app-db-password@postgres:5432/cortex

# --- Redis (cache + sessions + Celery broker/result backend, per architecture.md) --
# Distinct DB indexes to keep concerns logically separated on the one capped
# (maxmemory 256mb, allkeys-lru) redis container.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Email (Brevo, behind the EmailProvider interface) ------------------------
# `DEFAULT_FROM_EMAIL` is Django's OWN mail backend default (console/SMTP) --
# `BrevoProvider` never reads it. The address `BrevoProvider` actually sends
# from is `BREVO_SENDER_EMAIL` below (or, per-tenant, the "Sender email" field
# on the Admin -> Email Settings UI screen).
DEFAULT_FROM_EMAIL=Cortex <cortex@example.com>
BREVO_API_KEY=changeme-brevo-api-key
# ASSUMPTION (open question, docs/risks.md §3 Q6 — sender identity not yet
# confirmed): placeholder sender; update once the Brevo sender domain + SPF/
# DKIM/DMARC records are set up on the real domain from Q3. Must be a sender
# verified in Brevo (Senders, Domains & Dedicated IPs) — see
# docs/deployment-runbook.md §2.
BREVO_SENDER_EMAIL=cortex@example.com
BREVO_REPLY_TO=cortex@example.com
# No Brevo dashboard template ids to configure: every transactional email
# (password reset, overdue reminder, low-stock alert, reservation
# confirmed, approval request/decision) sends built-in HTML/text content
# via Brevo's inline-content API (`apps.notifications.content`). Real
# sending only needs BREVO_API_KEY/BREVO_SENDER_EMAIL (or the per-tenant UI
# equivalents) set.

# Encryption key for per-tenant email settings configured via the UI
# (`apps.notifications.models.EmailSettings.api_key_encrypted`). REPLACE with
# a real key before any tenant configures Brevo through the admin UI --
# generate one with `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"`. Deliberately NOT a valid Fernet
# key (unlike the placeholder above this comment was replaced with in an
# earlier draft) -- a deployment that forgets to replace this fails loudly
# (ImproperlyConfigured / decrypt error) instead of silently encrypting
# every tenant's Brevo key with a key published in this repo.
EMAIL_SETTINGS_ENCRYPTION_KEY=changeme-generate-a-fernet-key

# --- Cloudflare Tunnel ---------------------------------------------------------
# From the Cloudflare Zero Trust dashboard (Tunnels > create > token). Never
# commit a real value; cloudflared reads this at container start.
TUNNEL_TOKEN=changeme-cloudflare-tunnel-token

# --- Media storage (django-storages; filesystem now, S3-compatible later) -----
# ASSUMPTION (open question, docs/risks.md §3 Q4 — not yet confirmed): defaults
# to the mounted NAS volume for MVP. Switching MEDIA_STORAGE_BACKEND to "s3" and
# filling the S3_* vars below is a config-only change (no code change per
# architecture.md tier-2 path).
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
# Only required when MEDIA_STORAGE_BACKEND=s3 (e.g. Backblaze B2 / S3-compatible):
MEDIA_STORAGE_BUCKET_NAME=
MEDIA_STORAGE_ENDPOINT_URL=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
MEDIA_STORAGE_REGION=
